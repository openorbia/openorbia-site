{
  "name": "openorbia-site",
  "private": true,
  "type": "module",
  "description": "Source for https://openorbia.com: static site + Cloudflare Pages Functions + D1.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev": "node scripts/dev.mjs",
    "db:schema:local": "npx wrangler d1 execute openorbia-db --local --file=schema.sql",
    "db:schema:remote": "npx wrangler d1 execute openorbia-db --remote --file=schema.sql",
    "build:home": "node scripts/build-home.mjs",
    "db:migrate:local": "node scripts/migrate.mjs --local",
    "db:migrate:remote": "node scripts/migrate.mjs --remote",
    "seed:check": "node scripts/seed-launches.mjs --dry-run",
    "check:sources": "node scripts/check-sources.mjs",
    "seed:local": "node scripts/seed-launches.mjs --local",
    "seed:remote": "node scripts/seed-launches.mjs --remote",
    "db:schema:preview": "npx wrangler d1 execute openorbia-db-preview --remote --file=schema.sql",
    "db:migrate:preview": "node scripts/migrate.mjs --remote --db openorbia-db-preview",
    "seed:preview": "node scripts/seed-launches.mjs --remote --db openorbia-db-preview --include-samples --no-images --sample-date this-week --yes",
    "stamp": "node scripts/stamp-assets.mjs",
    "fetch:logos": "node scripts/fetch-logos.mjs",
    "deploy": "npm run stamp && npm test && npx wrangler pages deploy --project-name openorbia --branch main",
    "deploy:preview": "npm run stamp && npm test && npx wrangler pages deploy --project-name openorbia --branch launch-day",
    "build:email-art": "node scripts/build-email-art.mjs",
    "email:test": "node scripts/send-test-email.mjs",
    "launch:check": "node scripts/launch-check.mjs",
    "email:lineup": "node scripts/send-lineup.mjs"
  }
}
